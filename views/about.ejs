<%- include('partials/header', { currentPage: 'about', title: 'About | Ekum Electricals' }) %>

<main id="main-content">
  <section class="page-hero small-hero">
    <div class="hero-overlay"></div>
    <div class="container page-hero-inner">
      <div class="section-tag">01 / ABOUT EKUM</div>
      <h1>Dependable Electrical Expertise.</h1>
    </div>
  </section>

  <section class="page-content">
    <div class="container split-layout">
      <div>
        <h2>Electrical Expertise You Can Depend On.</h2>
        <p>
          Ekum Electricals provides dependable electrical installation, maintenance and engineering
          solutions for homes, offices, commercial properties and other facilities across Abuja.
        </p>
        <p>
          Our approach emphasizes careful planning, transparent communication and strong workmanship so
          every electrical system performs safely and reliably over time.
        </p>
      </div>

      <div class="info-panel">
        <ul>
          <li>Residential and commercial electrical work</li>
          <li>Maintenance and system diagnostics</li>
          <li>Safety-focused project execution</li>
          <li>Professional support from assessment to handover</li>
        </ul>
      </div>
    </div>
